{
    "name":  "@rsvp-dxb/server",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "node --watch src/index.js",
                    "start":  "node src/index.js",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "seed":  "node src/seed.js",
                    "build":  "node --check src/index.js \u0026\u0026 node --check src/seed.js",
                    "predev":  "npm run prisma:generate",
                    "prestart":  "npm run prisma:generate"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.1.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "prisma":  "^6.1.0"
                        }
}